# Self-managed iOS signing + TestFlight delivery — no EAS. `match` pulls certs/profiles from a
# private git repo; `gym` builds the .ipa; `pilot` uploads to TestFlight. An App Store Connect API
# key (ASC_KEY_*) authenticates all three, so no Apple ID password / 2FA is needed anywhere —
# which is load-bearing: no maintainer owns a Mac, so even the read-write `match` seeding runs
# headless in CI (mobile-ios-certs.yml → the :certs lane below).
default_platform(:ios)

BUNDLE_ID = "dev.robothanzo.trmission"
# The Live Activity widget extension (issue #43) — its own bundle id, App ID, and profile. The
# target + bundle id are created at prebuild time by apps/mobile/plugins/withLiveActivity.js; keep
# these three constants in step with TARGET_NAME/BUNDLE_SUFFIX there.
WIDGET_TARGET = "TRMissionWidget"
WIDGET_BUNDLE_ID = "#{BUNDLE_ID}.LiveActivity"

def asc_api_key
  # set_spaceship_token defaults to true, so this also authenticates the Spaceship::ConnectAPI
  # calls in `ensure_bundle_id` below.
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_P8"],
    is_key_content_base64: true
  )
end

# Register an App ID if it doesn't exist yet, through the same ASC API key everything else uses.
#
# `match` deliberately never creates bundle ids ("Couldn't find bundle identifier … for the user
# ''"), and the Live Activity extension needs its own — so without this the certs lane can only be
# unblocked from the Developer Portal's web form. No maintainer owns a Mac and every other Apple
# interaction in this project is headless, so do it here instead. Idempotent: an existing App ID is
# left exactly as it is, capabilities included.
def ensure_bundle_id(identifier, name)
  require "spaceship"
  # The ASC filter is a partial match, so re-check the identifier exactly.
  existing = Spaceship::ConnectAPI::BundleId
    .all(filter: { identifier: identifier })
    .find { |b| b.identifier == identifier }
  if existing
    UI.message("App ID #{identifier} already exists")
    return
  end
  UI.important("App ID #{identifier} is missing — creating it")
  Spaceship::ConnectAPI::BundleId.create(name: name, identifier: identifier, platform: "IOS")
end

platform :ios do
  desc "Build the app; upload to TestFlight only with upload:true (mobile-ios.yml passes it on real release tags)"
  lane :beta do |options|
    # GitHub runners boot with the login keychain locked — without a disposable CI keychain,
    # match's cert import prompts (and hangs/fails). No-op outside CI.
    setup_ci if ENV["CI"]

    api_key = asc_api_key

    # Read-only: certs/profiles were provisioned into the match repo by the :certs lane.
    match(type: "appstore", readonly: true, api_key: api_key)

    # `expo prebuild` emits an Automatic-signing project with no team, which xcodebuild rejects
    # for device archives ("requires a development team"). Flip the APP and WIDGET targets — and
    # only those — to manual signing with their own match profiles; do not do this via gym xcargs,
    # which would also hit the Pods resource-bundle targets (they can't take a provisioning
    # profile). Each target gets its own call: one bundle id / profile pair per target.
    team_id = ENV["APPLE_TEAM_ID"].to_s
    UI.user_error!("APPLE_TEAM_ID must be set (repo variable) — the prebuilt project carries no team id") if team_id.empty?
    profiles = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    profile_name = profiles[BUNDLE_ID]
    widget_profile_name = profiles[WIDGET_BUNDLE_ID]
    if widget_profile_name.nil?
      UI.user_error!("no match profile for #{WIDGET_BUNDLE_ID} — dispatch mobile-ios-certs (force:true) after adding the App ID; see docs/release/app-store-connect-setup.md")
    end
    { BUNDLE_ID => ["TRMission", profile_name], WIDGET_BUNDLE_ID => [WIDGET_TARGET, widget_profile_name] }.each do |bundle_id, (target, profile)|
      update_code_signing_settings(
        path: "ios/TRMission.xcodeproj",
        use_automatic_signing: false,
        team_id: team_id,
        code_sign_identity: "Apple Distribution",
        profile_name: profile,
        bundle_identifier: bundle_id,
        targets: [target]
      )
    end

    # Workspace/scheme names verified against prebuild's rename logic (@expo/cli
    # renameTemplateAppName: HelloWorld → IOSConfig.XcodeUtils.sanitizedName(name)). The app's
    # display name is bilingual ("台鐵任務 TRMission", App Store Guideline 2.3.8 — see app.config.ts)
    # and sanitizedName strips every non-word character, so it still resolves to "TRMission" here.
    # Renaming the app to Chinese ALONE would sanitize to the literal "app" and break these paths;
    # app.config.test.ts pins the invariant, and mobile-ios.yml also asserts the workspace exists
    # right after `pod install` so a template change fails loudly there.
    gym(
      workspace: "ios/TRMission.xcworkspace",
      scheme: "TRMission",
      export_method: "app-store",
      output_directory: "build",
      export_options: {
        # Both bundles: exporting an .ipa whose embedded .appex has no mapping fails the export.
        provisioningProfiles: {
          BUNDLE_ID => profile_name,
          WIDGET_BUNDLE_ID => widget_profile_name
        }
      }
    )

    # App Store Connect rejects an .app that carries a dSYM nested inside an embedded framework
    # ("Invalid bundle structure", ITMS 90171 — mobile-ios.yml's strip step has the full history).
    # altool only says so ~10 minutes into pilot's upload, and only on the tag runs that upload at
    # all, so assert it here instead: every run pays a one-second `unzip -Z1`, and a regression is
    # named where it was caused rather than at the end of a release.
    ipa = lane_context[SharedValues::IPA_OUTPUT_PATH]
    nested_dsyms = `unzip -Z1 "#{ipa}" '*.framework/dSYMs/*' 2>/dev/null`.split("\n")
    unless nested_dsyms.empty?
      UI.user_error!("#{nested_dsyms.length} dSYM entries are nested inside embedded frameworks — App Store Connect would reject this build (ITMS 90171). First: #{nested_dsyms.first}. Check mobile-ios.yml's `pod install` env (RCT_SYMBOLICATE_PREBUILT_FRAMEWORKS must stay unset) and its Pods cache namespace.")
    end

    if options[:upload]
      pilot(
        api_key: api_key,
        skip_waiting_for_build_processing: true
      )
    else
      # Non-tag runs (workflow_dispatch, release/** pushes) all carry the dev fallback
      # BUILD_NUMBER=1 — TestFlight rejects duplicate build numbers, so they build-only; the
      # .ipa lands in build/ and mobile-ios.yml uploads it as a workflow artifact instead.
      UI.important("upload:false — skipping TestFlight; the .ipa is in build/")
    end
  end

  desc "Seed/rotate the Distribution cert + App Store profile in the match repo (run via mobile-ios-certs.yml — no Mac needed)"
  lane :certs do |options|
    setup_ci if ENV["CI"]
    api_key = asc_api_key

    # The widget extension's App ID carries no capabilities, so it can be created from here rather
    # than by hand (see ensure_bundle_id). The APP's App ID is deliberately NOT auto-created: its
    # three capabilities (Sign In with Apple, Associated Domains, Push Notifications) have to be
    # enabled in the portal anyway, and a profile is a snapshot of them — see
    # docs/release/app-store-connect-setup.md Step 2.
    ensure_bundle_id(WIDGET_BUNDLE_ID, "TRMission Live Activity")

    # readonly:false — creates whatever is missing (cert and/or profiles) via the ASC API and
    # pushes it, MATCH_PASSWORD-encrypted, to MATCH_GIT_URL. force:true regenerates the profiles
    # even if they exist — required after enabling a new capability, since a profile is a snapshot
    # of the App ID's capabilities.
    match(
      type: "appstore",
      readonly: false,
      force: options[:force] || false,
      api_key: api_key
    )
  end
end

# Play publishing via a service-account JSON key (Play Developer API) — no EAS, same self-managed
# posture as iOS. `PLAY_JSON_KEY_FILE` is a decoded-in-CI path (mobile-android.yml); for local runs
# export it yourself. See docs/release/play-console-setup.md for how to provision the key.
#
# CI only ever calls :internal — it never touches the live store listing/images and never
# promotes a track. `metadata`/`promote` are deliberately local-only lanes.
platform :android do
  desc "Upload the signed AAB to Play's internal testing track"
  lane :internal do
    upload_to_play_store(
      track: "internal",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      json_key: ENV["PLAY_JSON_KEY_FILE"],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Push the committed store listing (fastlane/metadata/android) — run locally, not in CI"
  lane :metadata do
    upload_to_play_store(
      json_key: ENV["PLAY_JSON_KEY_FILE"],
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote the current internal-track build to production — run locally, not in CI"
  lane :promote do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      json_key: ENV["PLAY_JSON_KEY_FILE"],
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
