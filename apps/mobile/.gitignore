# Continuous Native Generation — android/ and ios/ are generated by `expo prebuild` in CI,
# never committed. .expo/ is local Metro/dev cache.
/android
/ios
/.expo
/dist
# fastlane gym's .ipa output (mobile-ios.yml uploads it as a workflow artifact).
/build
# `npx @expo/fingerprint .` output, recorded by mobile-ota.yml for traceability (uploaded as a
# workflow artifact). This MUST stay ignored: `eoas publish` refuses to run on a dirty working tree
# ("Commit all changes. Aborting..."), so an untracked fingerprint.json fails the whole OTA lane.
/fingerprint.json
*.log
# RNRepo's local prebuilt-artifact cache (see app.config.ts + .fingerprintignore).
.rnrepo-cache/
# Copied by scripts/setup-web.js for the web harness — a ~7MB binary, never committed.
/public/canvaskit.wasm
/public/fonts/
