{
  "name": "@trm/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "node scripts/setup-web.js && expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc7 --noEmit",
    "lint": "eslint src",
    "test": "jest",
    "test:pure": "vitest run"
  },
  "dependencies": {
    "@bottom-tabs/react-navigation": "^1.4.0",
