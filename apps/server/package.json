{
  "name": "@trm/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch --import ./instrument.mjs src/main.ts",
    "start": "node --import ./instrument.mjs src/main.ts",
    "typecheck": "tsc7 --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "preview:og": "node --import @swc-node/register/esm-register scripts/render-og-cards.ts",
    "gen:feature-graphic": "node --import @swc-node/register/esm-register scripts/gen-feature-graphic.ts",
    "warm-mongo": "node --import @swc-node/register/esm-register scripts/warm-mongo-binary.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/argon2": "^2.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/nestjs": "^10.70.0",
    "@trm/bots": "workspace:*",
    "@trm/codec": "workspace:*",
    "@trm/engine": "workspace:*",
    "@trm/map-data": "workspace:*",
    "@trm/proto": "workspace:*",
    "@trm/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.8",
    "mongodb": "^7.5.0",
    "nestjs-zod": "^5.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.47",
    "@trm/tsc7": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  }
}
